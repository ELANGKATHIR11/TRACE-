{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "start": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist', {recursive: true, force: true})\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:push": "node ./node_modules/prisma/build/index.js db push",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs server/db/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@prisma/client": "^6.4.1",
    "@reduxjs/toolkit": "^2.13.0",
