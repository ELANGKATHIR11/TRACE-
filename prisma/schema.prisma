generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String       @id @default(uuid())
  email                  String       @unique
  passwordHash           String
  name                   String
  role                   String
  roleLabel              String
  title                  String
  organization           String
  institutionId          String?
  badgeCode              String
  permissionsDescription String
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  auditEvents            AuditEvent[]
  sessions               Session[]
  institution            Institution? @relation(fields: [institutionId], references: [id])

  @@index([email])
  @@index([institutionId])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Institution {
  id                  String                 @id @default(uuid())
  name                String
  code                String                 @unique
  type                String
  region              String
  address             String
  establishedYear     Int
  accreditationStatus String
  contactEmail        String
  contactPhone        String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  alerts              Alert[]
  applications        Application[]
  auditEvents         AuditEvent[]
  claims              Claim[]
  findings            ComplianceFinding[]
  obligations         ComplianceObligation[]
  tasks               CorrectiveTask[]
  documents           Document[]
  shadowEvaluations   ShadowEvaluation[]
  users               User[]

  @@index([code])
}

model Application {
  id                  String                 @id @default(uuid())
  code                String                 @unique
  institutionId       String
  category            String
  academicYear        String
  programName         String
  requestedIntake     Int
  currentIntake       Int
  ruleSetId           String
  currentStage        String
  officialOutcome     String
  submittedAt         DateTime?
  lastEvaluatedAt     DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  alerts              Alert[]
  institution         Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  versions            ApplicationVersion[]
  auditEvents         AuditEvent[]
  claims              Claim[]
  claimRelationships  ClaimRelationship[]
  findings            ComplianceFinding[]
  obligations         ComplianceObligation[]
  tasks               CorrectiveTask[]
  documents           Document[]
  fixPreviews         FixPreview[]
  reviewPriority      ReviewPriority?
  shadowEvaluations   ShadowEvaluation[]
  validationManifests ValidationManifest[]

  @@index([institutionId])
  @@index([code])
  @@index([currentStage])
}

model ApplicationVersion {
  id            String      @id @default(uuid())
  applicationId String
  version       String
  snapshotJson  String
  changedBy     String
  changeReason  String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Document {
  id                    String                    @id @default(uuid())
  applicationId         String
  institutionId         String
  title                 String
  category              String
  fileType              String
  fileName              String
  filePath              String?
  fileSize              String
  sha256                String
  uploadedAt            DateTime                  @default(now())
  uploadedBy            String
  expiryDate            DateTime?
  currentVersion        String                    @default("v1.0")
  requiredByClauseId    String
  isMandatory           Boolean                   @default(true)
  validationState       String                    @default("Needs manual review")
  ocrConfidenceAvg      Float                     @default(0.0)
  crossDocConsistency   String                    @default("Not applicable")
  integrityScreening    String                    @default("Signature & hash structure intact")
  issuerVerification    String                    @default("Pending external authority confirmation")
  ruleEvaluation        String                    @default("Conditional — requires physical scrutiny")
  humanReviewOutcome    String                    @default("Unreviewed")
  recommendedNextAction String                    @default("Complete independent document verification")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  boundingBoxes         BoundingBox[]
  claims                Claim[]
  findings              ComplianceFinding[]
  application           Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  institution           Institution               @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  pages                 DocumentPage[]
  fingerprints          DocumentPageFingerprint[]
  versions              DocumentVersion[]
  extractedFields       ExtractedField[]
  caches                ProcessingCache[]
  reprocessingLogs      ReprocessingLog[]
  reviewerNotes         ReviewerNote[]

  @@index([applicationId])
  @@index([institutionId])
  @@index([sha256])
  @@index([validationState])
}

model DocumentVersion {
  id              String   @id @default(uuid())
  documentId      String
  version         String
  fileName        String
  filePath        String?
  fileSize        String
  sha256          String
  validationState String
  changeNote      String
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentPage {
  id                String   @id @default(uuid())
  documentId        String
  pageNumber        Int
  title             String
  headerAuthority   String
  certificateNumber String
  issueDate         String
  bodyLines         String
  stampText         String
  signatory         String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model BoundingBox {
  id         String   @id @default(uuid())
  documentId String
  pageNumber Int
  x          Float
  y          Float
  width      Float
  height     Float
  label      String
  category   String
  status     String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model ExtractedField {
  id                      String   @id @default(uuid())
  documentId              String
  key                     String
  label                   String
  extractedValue          String
  matchedApplicationValue String
  expectedRuleValue       String?
  ocrConfidence           Float    @default(0.0)
  confidenceBand          String
  pageNumber              Int
  boundingBoxId           String
  crossDocStatus          String
  comparedWithDocId       String?
  comparedWithDocName     String?
  comparedWithValue       String?
  ruleClauseId            String
  validationState         String
  reviewerConfirmed       Boolean  @default(false)
  reviewerComment         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  document                Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([key])
}

model ReviewerNote {
  id         String   @id @default(uuid())
  documentId String
  author     String
  role       String
  note       String
  timestamp  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model RegulatorySource {
  id              String             @id @default(uuid())
  title           String
  publicationCode String             @unique
  edition         String
  academicYear    String
  authority       String
  sourceUrl       String?
  publicationDate DateTime
  status          String             @default("Official Published")
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  clauses         RegulatoryClause[]

  @@index([publicationCode])
}

model RegulatoryClause {
  id                  String           @id @default(uuid())
  sourceId            String
  ruleSetId           String
  clauseNumber        String
  title               String
  excerpt             String
  fullText            String
  pageReference       String
  category            String
  applicability       String
  isMandatory         Boolean          @default(true)
  penaltyDescription  String?
  remediationGuidance String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  source              RegulatorySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([ruleSetId])
  @@index([clauseNumber])
}

model RuleSet {
  id            String    @id @default(uuid())
  title         String
  code          String    @unique
  edition       String
  academicYear  String
  version       String
  status        String
  description   String
  publishedAt   DateTime?
  publishedBy   String?
  publishedNote String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([code])
  @@index([academicYear])
}

model ComplianceFinding {
  id                  String          @id @default(uuid())
  title               String
  applicationId       String
  institutionId       String
  requirementId       String
  requirementTitle    String
  ruleSetId           String
  ruleVersion         String
  academicYear        String
  clauseId            String
  clauseNumber        String
  clauseExcerpt       String
  sourceDocumentTitle String
  sourcePageRef       String
  documentId          String?
  documentTitle       String?
  pageNumber          Int?
  boundingBoxId       String?
  fieldId             String?
  fieldKey            String?
  fieldLabel          String?
  extractedValue      String?
  expectedValue       String?
  discrepancyNote     String
  severity            String
  lifecycleStatus     String
  assignedTaskId      String?
  resolvedAt          DateTime?
  resolvedBy          String?
  resolutionNote      String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  application         Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document            Document?       @relation(fields: [documentId], references: [id])
  institution         Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  assignedTask        CorrectiveTask?
  fixPreviews         FixPreview[]

  @@index([applicationId])
  @@index([institutionId])
  @@index([lifecycleStatus])
  @@index([severity])
}

model CorrectiveTask {
  id              String            @id @default(uuid())
  findingId       String            @unique
  applicationId   String
  institutionId   String
  taskCode        String            @unique
  title           String
  description     String
  assigneeName    String
  assigneeRole    String
  priority        String
  status          String
  dueDate         DateTime
  requiredAction  String
  responseComment String?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  application     Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  finding         ComplianceFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  institution     Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@index([applicationId])
  @@index([institutionId])
  @@index([status])
}

model ComplianceObligation {
  id                String      @id @default(uuid())
  title             String
  institutionId     String
  applicationId     String
  clauseId          String
  clauseNumber      String
  regulationRef     String
  academicYear      String
  category          String
  dueDate           DateTime
  frequency         String
  status            String
  evidenceRequired  String
  evidenceSubmitted String?
  penaltyRisk       String
  lastAssessedAt    DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  institution       Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([applicationId])
  @@index([status])
}

model Alert {
  id             String       @id @default(uuid())
  applicationId  String?
  institutionId  String
  code           String       @unique
  type           String
  severity       String
  title          String
  message        String
  sourceClauseId String
  targetRole     String
  triggeredAt    DateTime     @default(now())
  acknowledged   Boolean      @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?
  channels       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([acknowledged])
}

model AuditEvent {
  id                String       @id @default(uuid())
  actorId           String
  actorName         String
  actorRole         String
  action            String
  entityType        String
  entityId          String
  applicationId     String?
  institutionId     String?
  previousState     String?
  newState          String?
  ruleVersion       String?
  evidenceReference String?
  ipAddress         String?
  userAgent         String?
  outcome           String       @default("Success")
  timestamp         DateTime     @default(now())
  user              User         @relation(fields: [actorId], references: [id])
  application       Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  institution       Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([applicationId])
  @@index([institutionId])
  @@index([action])
  @@index([timestamp])
}

model BackgroundJob {
  id          String    @id @default(uuid())
  type        String
  payload     String
  status      String    @default("PENDING")
  error       String?
  result      String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([status])
  @@index([type])
}

model Claim {
  id                  String              @id @default(uuid())
  applicationId       String
  institutionId       String
  documentId          String
  documentVersion     String              @default("v1.0")
  claimType           String
  claimKey            String
  rawValue            String
  normalizedValue     String
  pageNumber          Int                 @default(1)
  boundingBoxId       String?
  extractionModel     String              @default("PyMuPDF+EasyOCR")
  modelVersion        String              @default("2.0.0")
  confidence          Float               @default(0.95)
  relevantDate        DateTime?
  timePeriod          String?
  ruleReferences      String?
  reviewStatus        String              @default("Unreviewed")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  application         Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document            Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  institution         Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  sourceRelationships ClaimRelationship[] @relation("SourceClaim")
  targetRelationships ClaimRelationship[] @relation("TargetClaim")

  @@index([applicationId])
  @@index([documentId])
  @@index([claimType])
  @@index([claimKey])
}

model ClaimRelationship {
  id                     String      @id @default(uuid())
  applicationId          String
  sourceClaimId          String
  targetClaimId          String
  relationType           String
  severity               String      @default("Moderate")
  explanation            String
  sourceValueSummary     String
  targetValueSummary     String
  status                 String      @default("Open")
  sourceEvidenceDocTitle String?
  sourceEvidencePage     Int?
  targetEvidenceDocTitle String?
  targetEvidencePage     Int?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  application            Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sourceClaim            Claim       @relation("SourceClaim", fields: [sourceClaimId], references: [id], onDelete: Cascade)
  targetClaim            Claim       @relation("TargetClaim", fields: [targetClaimId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([sourceClaimId])
  @@index([targetClaimId])
  @@index([relationType])
  @@index([status])
}

model DocumentPageFingerprint {
  id               String   @id @default(uuid())
  documentId       String
  pageNumber       Int
  pageHash         String
  textHash         String
  hasVisualChanges Boolean  @default(false)
  lastProcessedAt  DateTime @default(now())
  extractorVersion String   @default("v2.0.0")
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([pageHash])
}

model ProcessingCache {
  id               String   @id @default(uuid())
  documentId       String
  pageNumber       Int
  cacheKey         String   @unique
  cachedResultJson String
  hitCount         Int      @default(0)
  extractorVersion String   @default("v2.0.0")
  modelVersion     String   @default("2.0.0")
  ruleVersion      String   @default("v2026.1")
  isValid          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([isValid])
}

model ReprocessingLog {
  id                      String   @id @default(uuid())
  documentId              String
  previousVersion         String
  newVersion              String
  totalPages              Int
  pagesReprocessed        Int
  pagesReused             Int
  cacheHitRate            Float
  processingTimeMs        Int
  estimatedSavingsPercent Float
  planJson                String
  createdAt               DateTime @default(now())
  document                Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model RulesetComparison {
  id                     String   @id @default(uuid())
  sourceRulesetId        String
  targetRulesetId        String
  comparisonSummary      String
  changedClausesCount    Int      @default(0)
  addedClausesCount      Int      @default(0)
  removedClausesCount    Int      @default(0)
  supersededClausesCount Int      @default(0)
  clausesDiffJson        String
  performedBy            String
  createdAt              DateTime @default(now())

  @@index([sourceRulesetId])
  @@index([targetRulesetId])
}

model ShadowEvaluation {
  id                      String      @id @default(uuid())
  rulesetVersion          String
  targetApplicationId     String
  institutionId           String
  oldOutcome              String
  newOutcome              String
  diffReportJson          String
  affectedObligationsJson String
  status                  String      @default("Shadow Complete")
  conductedBy             String
  createdAt               DateTime    @default(now())
  institution             Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  application             Application @relation(fields: [targetApplicationId], references: [id], onDelete: Cascade)

  @@index([targetApplicationId])
  @@index([institutionId])
  @@index([rulesetVersion])
}

model ImpactReport {
  id                        String    @id @default(uuid())
  title                     String
  rulesetCode               String
  summary                   String
  totalApplicationsImpacted Int
  criticalFindingsDelta     Int
  majorFindingsDelta        Int
  impactedApplicationIds    String
  remediationTasksJson      String
  isPublished               Boolean   @default(false)
  publishedBy               String?
  publishedAt               DateTime?
  createdAt                 DateTime  @default(now())

  @@index([rulesetCode])
  @@index([isPublished])
}

model FixPreview {
  id                        String            @id @default(uuid())
  findingId                 String
  applicationId             String
  proposedFieldKey          String
  originalValue             String
  proposedValue             String
  isHypothetical            Boolean           @default(true)
  hypotheticalFindingStatus String
  remainingConflictsJson    String
  requiredEvidenceGuidance  String
  previewOutcomeSummary     String
  createdBy                 String
  createdAt                 DateTime          @default(now())
  application               Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  finding                   ComplianceFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@index([applicationId])
}

model ReviewPriority {
  id                   String      @id @default(uuid())
  applicationId        String      @unique
  priorityScore        Float
  rank                 Int
  urgencyBand          String
  scoringFactorsJson   String
  explanationText      String
  assignedReviewerId   String?
  assignedReviewerName String?
  reviewerWorkload     Int         @default(1)
  calculatedAt         DateTime    @default(now())
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([priorityScore])
  @@index([rank])
}

model ValidationManifest {
  id                   String      @id @default(uuid())
  applicationId        String
  assessmentId         String
  documentHashesJson   String
  claimReferencesJson  String
  ruleVersionUsed      String
  pipelineVersionsJson String
  normalizedInputsJson String
  ruleEvaluationsJson  String
  manifestHash         String
  previousManifestHash String
  signedBy             String
  signedAt             DateTime    @default(now())
  verifiedAt           DateTime?
  verificationStatus   String      @default("Valid Chain")
  application          Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([assessmentId])
  @@index([manifestHash])
}

model SystemSetting {
  id                          String   @id @default("CURRENT")
  appName                     String   @default("TRACE — Regulatory Assurance & Compliance Engine")
  environmentLabel            String   @default("Production GovTech (Statutory AY 2026-27)")
  defaultAcademicYear         String   @default("2026-27")
  defaultLanguage             String   @default("en-IN")
  timezone                    String   @default("Asia/Kolkata")
  maxUploadSizeBytes          Int      @default(26214400)
  maxPagesPerDoc              Int      @default(50)
  allowedDocFormats           String   @default("[\"PDF\",\"PNG\",\"JPEG\",\"TIFF\"]")
  docProcessingTimeoutSeconds Int      @default(60)
  documentRetentionDays       Int      @default(1825)
  maintenanceMode             Boolean  @default(false)
  ocrLanguages                String   @default("[\"eng\",\"hin\"]")
  ocrTimeoutSeconds           Int      @default(45)
  renderDpi                   Int      @default(200)
  batchSize                   Int      @default(4)
  maxConcurrentJobs           Int      @default(2)
  retryPolicyMaxRetries       Int      @default(2)
  cacheEnabled                Boolean  @default(true)
  cacheInvalidationPolicy     String   @default("On Document Remediated")
  runOptionalMlAnalysis       Boolean  @default(true)
  reminderLeadDays            Int      @default(7)
  escalationIntervalHours     Int      @default(48)
  notificationRetryLimit      Int      @default(3)
  processingJobRetentionDays  Int      @default(90)
  auditLogRetentionDays       Int      @default(3650)
  updatedBy                   String?
  updatedAt                   DateTime @updatedAt
  version                     Int      @default(1)
}

model SystemSettingVersion {
  id                 String   @id @default(uuid())
  versionNumber      Int
  configSnapshotJson String
  changedBy          String
  changeReason       String?
  createdAt          DateTime @default(now())

  @@index([versionNumber])
}

model MlModelRecord {
  id                    String    @id
  name                  String
  purpose               String
  modelType             String
  currentVersion        String
  availableVersionsJson String
  artifactPath          String
  artifactSizeBytes     Int
  isEnabled             Boolean   @default(true)
  status                String    @default("Available")
  trainingStatus        String    @default("Trained")
  lastTrainedAt         DateTime?
  datasetName           String
  datasetVersion        String
  metricsJson           String
  inferenceThreshold    Float     @default(0.85)
  timeoutSeconds        Int       @default(30)
  lastInferenceAt       DateTime?
  avgLatencyMs          Float     @default(18.5)
  lastErrorSummary      String?
  evaluationReportJson  String?
  previousVersion       String?
  previousMetricsJson   String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([isEnabled])
  @@index([status])
}

model TrainingJob {
  id                String    @id @default(uuid())
  modelId           String
  datasetName       String
  datasetVersion    String
  status            String    @default("Queued")
  progressPercent   Float     @default(0)
  currentStage      String    @default("Initializing")
  epochsTotal       Int       @default(10)
  currentEpoch      Int       @default(0)
  loss              Float?
  metricsJson       String?
  logsJson          String    @default("[]")
  artifactPath      String?
  artifactSizeBytes Int?
  startedAt         DateTime?
  completedAt       DateTime?
  failedReason      String?
  initiatedBy       String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([modelId])
  @@index([status])
}

model DatasetManifest {
  id             String   @id
  name           String
  source         String
  version        String
  licenseStatus  String
  sizeBytes      Int
  checksumSha256 String
  trainSamples   Int
  valSamples     Int
  testSamples    Int
  isAllowlisted  Boolean  @default(true)
  isDownloaded   Boolean  @default(true)
  localPath      String
  createdAt      DateTime @default(now())

  @@index([isAllowlisted])
}

model ConfigAuditEvent {
  id                String   @id @default(uuid())
  section           String
  action            String
  details           String
  actorId           String
  actorName         String
  actorRole         String
  ipAddress         String?
  previousValueJson String?
  newValueJson      String?
  createdAt         DateTime @default(now())

  @@index([section])
  @@index([actorId])
  @@index([createdAt])
}
